// kind=shader

// Draws a toy held at a stable position (`iStable`, the finger) while its material is pulled
// towards the snapped position where it would rest (`iSnapped`).

uniform shader iToy;
uniform float2 iStable;   // window px of the held material point
uniform float2 iSnapped;  // window px of the same material point under the snapped pose
uniform float iPlateau;   // px radius around iStable that moves rigidly with the finger

const float kSqueeze = 1.0;  // max extra cm of toy material shown per cm of screen
const float kSplit = 2.0;    // max r/g/b separation, px

vec4 main(vec2 px) {
    vec2 axis = iStable - iSnapped;
    float gap = length(axis);
    if (gap < 0.5) {
        return iToy.eval(px);
    }
    float falloff = 1.5 * gap / kSqueeze;  // smoothstep's max slope is 1.5 / width
    float t = smoothstep(iPlateau, iPlateau + falloff, distance(px, iStable));
    vec2 displacement = axis * t;
    vec2 split = axis / gap * min(kSplit, gap * 0.01) * t;
    vec4 r = iToy.eval(px + displacement);
    vec4 g = iToy.eval(px + displacement - split);
    vec4 b = iToy.eval(px + displacement - split * 2.0);
    return vec4(r.r, g.g, b.b, max(r.a, max(g.a, b.a)));
}
