// kind=shader

uniform shader surface;
uniform shader displacement;
uniform float maxDisplacement;

// metric units (meters)
const float kRgbSplitMax = 0.001;
const float kRgbSplitStart = 0.02;
const float kRgbSplitFull = 0.05;

vec4 main(vec2 local) {
    vec2 offset = displacement.eval(local).rg;
    vec2 p = local + offset;
    float len = length(offset);
    if (len < 1e-9 || maxDisplacement < kRgbSplitStart) {
        return surface.eval(p);
    }
    // RGB split
    vec2 split = offset / len *  // direction vector (unitless)
    smoothstep(kRgbSplitStart, kRgbSplitFull, maxDisplacement) *  // ratio (unitless) - makes the effect start smoothly
    min(len * 0.25, kRgbSplitMax) *  // length
    (1 - clamp(len / maxDisplacement, 0.0, 1.0));  // ratio (unitless) - reduces split to 0 at anchor
    vec4 r = surface.eval(p);
    vec4 g = surface.eval(p - split);
    vec4 b = surface.eval(p - 2.0 * split);
    return vec4(r.r, g.g, b.b, (r.a + g.a + b.a) / 3);
}
