// kind=shader

uniform shader surface;
uniform shader displacement;
uniform float maxDisplacement;

const float kRgbSplitRatio = 0.01;
const float kRgbSplitMax = 0.0005;
const float kRgbSplitStart = 0.01;
const float kRgbSplitFull = 0.03;

vec4 main(vec2 local) {
    vec2 offset = displacement.eval(local).rg;
    vec2 p = local + offset;
    float len = length(offset);
    if (len < 1e-9 || maxDisplacement < kRgbSplitStart) {
        return surface.eval(p);
    }
    // RGB split
    float t = clamp(len / maxDisplacement, 0.0, 1.0);
    // TODO: drop components that don't bring any significant effects
    vec2 split =
    offset / len *
    min(kRgbSplitMax, maxDisplacement * kRgbSplitRatio) *
    smoothstep(0.02, 0.3, t) * (1.0 - smoothstep(0.7, 0.92, t)) *
    smoothstep(kRgbSplitStart, kRgbSplitFull, maxDisplacement);
    vec4 r = surface.eval(p);
    vec4 g = surface.eval(p - split);
    vec4 b = surface.eval(p - 2.0 * split);
    return vec4(r.r, g.g, b.b, (r.a + g.a + b.a) / 3);
}
